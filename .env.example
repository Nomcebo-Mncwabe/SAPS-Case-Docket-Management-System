# .env.example  -  copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore and must NEVER be committed to GitHub.

# ---- Security --------------------------------------------------------
# Any long random string. Generate one in PyCharm's terminal with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Database (leave as-is for the local SQLite prototype) -----------
# (No database variables are required here - config.py builds the SQLite
#  path automatically as saps_docket.db in the project folder.)

# ---- E-mail (case reference + citizen OTP) ----------------------------
# If you leave MAIL_USERNAME / MAIL_PASSWORD empty, the application still
# runs: e-mails are printed to the PyCharm console instead of being sent.
# This is useful for development and marking without a real mailbox.
#
# Example values for a Gmail account with an "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=

# ---- Citizen OTP rules -------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
CITIZEN_SESSION_MINUTES=15

# ---- Login protection ---------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
SESSION_TIMEOUT_MINUTES=30

# ---- Standstill / escalation (CONFIGURABLE - not hard-coded) -----------
# A case with no activity for this many days is flagged for a supervisor.
CASE_STANDSTILL_DAYS=7

# ---- Display -------------------------------------------------------------
DISPLAY_UTC_OFFSET_HOURS=2
PAGE_SIZE=10
SHOW_OFFICER_NAME_TO_CITIZEN=True

# ---- Development helpers --------------------------------------------------
FLASK_DEBUG=True
SEED_DEMO_DATA=True
SESSION_COOKIE_SECURE=False
